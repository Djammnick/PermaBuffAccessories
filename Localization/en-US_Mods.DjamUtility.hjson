Buffs: {
	AquaticAbility: {
		DisplayName: Aquatic Ability
		Description: Improved mobility in water.
	}

	WonderfulArcana: {
		DisplayName: Wonderful Arcana
		Description: Magic flows through you.
	}

	UndergroundImmersion: {
		DisplayName: Underground Immersion
		Description: The Caverns are your home.
	}

	SuperLucky: {
		DisplayName: Super Lucky
		Description: You are blessed with immense luck.
	}

	SummonersFocus: {
		DisplayName: Summoners Focus
		Description: You are filled with the power of companionship.
	}

	RangersProficiency: {
		DisplayName: Rangers Proficiency
		Description: A sharpshooter's blessing improves your shot.
	}

	PotentBait: {
		DisplayName: Potent Bait
		Description: Your reels are more potent than ever.
	}

	PerfectVision: {
		DisplayName: Perfect Vision
		Description: Your vision becomes stronger.
	}

	LovelyStench: {
		DisplayName: Lovely Stench
		Description: The smell is indescribable.
	}

	LocationInstability: {
		DisplayName: Location Instability
		Description: Your presence is unstable.
	}

	LifeSupport: {
		DisplayName: Life Support
		Description: A pure protection.
	}

	HeavilyProtected: {
		DisplayName: Heavily Protected
		Description: Your armor toughens.
	}

	FieryInheritance: {
		DisplayName: Fiery Inheritance
		Description: Flames dance around you.
	}

	BlessingOfVitality: {
		DisplayName: Blessing Of Vitality
		Description: Your heartbeat quickens. Your life lasts a moment longer.
	}

	BlessingOfUtility: {
		DisplayName: Blessing Of Utility
		Description: You are the catalyst of creation.
	}

	BlessingOfPieselopadaka: {
		DisplayName: Blessing Of Pieselopadaka
		Description: The world is at your command.
	}

	BlessingOfDestruction: {
		DisplayName: Blessing Of Destruction
		Description: Nothing will stand in your way.
	}

	Berserk: {
		DisplayName: Berserk
		Description: Your blood boils in fury.
	}
}

Items: {
	PrakMusicBox: {
		Tooltip: A blessed tune.
		DisplayName: Prak Music Box
	}

	LivingBrewery: {
		Tooltip: Used to fuse many powerful forces into one.
		DisplayName: Living Brewery
	}

	DemoniteBrewery: {
		Tooltip: Used to craft accessories with permanent buff effects.
		DisplayName: Demonite Brewery
	}

	CrimtaneBrewery: {
		Tooltip: Used to craft accessories with permanent buff effects.
		DisplayName: Crimtane Brewery
	}

	SingularityOfPieselopadaka: {
		Tooltip:
			'''
			The core of the world.
			Grants all blessings at the same time.
			'''
		DisplayName: Singularity Of Pieselopadaka
	}

	ShardOfVitality: {
		Tooltip:
			'''
			A small piece of your lifeforce.
			Improves your survivability.
			'''
		DisplayName: Shard Of Vitality
	}

	ShardOfUtility: {
		Tooltip:
			'''
			A small piece of your creation.
			Improves your sight, mobility and terrain manipulation.
			'''
		DisplayName: Shard Of Utility
	}

	ShardOfDestruction: {
		Tooltip:
			'''
			A small piece of your power.
			Improves your destructive potential.
			'''
		DisplayName: Shard Of Destruction
	}

	SummonersCatalyst: {
		Tooltip: A mystical token used to bind more creatures to you.
		DisplayName: Summoners Catalyst
	}

	RangersGlove: {
		Tooltip: A fine-crafted glove. Strengthens your arm while using ranged weapons.
		DisplayName: Rangers Glove
	}

	PortableLifeSupport: {
		Tooltip: A light Medical Kit. Increases your vitality.
		DisplayName: Portable Life Support
	}

	MuskyPerfumes: {
		Tooltip: A flask full of disgusting stench in form of perfume. Why would you use this?
		DisplayName: Musky Perfumes
	}

	LocationWarper: {
		Tooltip: An unstable artifact. Allows you to flip yourself upside down.
		DisplayName: Location Warper
	}

	IronboundBracelet: {
		Tooltip: A bracelet made of most magical metals. Makes your skin ironlike.
		DisplayName: Ironbound Bracelet
	}

	HellishCharm: {
		Tooltip: A very hot molten charm. Projects a circle of fire around you.
		DisplayName: Hellish Charm
	}

	HandheldDrill: {
		Tooltip:
			'''
			A drill fitting only in worthy hands. 
			Projects light around you, while making light sources stronger, and enchances your mining efficiency.
			'''
		DisplayName: Handheld Drill
	}

	FourLeafClover: {
		Tooltip: A very lucky charm. Makes fortune favor you more.
		DisplayName: Four Leaf Clover
	}

	FishermansScanner: {
		Tooltip: A trout monkey's favourite tool. Enchances your bait, as well as your eye for fish and crate.
		DisplayName: Fishermans Scanner
	}

	DjamsGlasses: {
		Tooltip: A mighty pair of glasses. Grants you most potent vision.
		DisplayName: Djams Glasses
	}

	BerserkersCirclet: {
		Tooltip:
			'''
			Grants the combined Wrath and Rage buffs.
			This buff does not stack with its downgrades.
